---
/**
 * A Geordi window that plays through a piece of work: a message, an agent at work, its
 * changes, and the ribbon taking them to a merged pull request. Drawn from the app's own
 * utilities, so it looks as the app does.
 *
 * Everything that comes and goes says when: `at(from, until)` marks an element as shown
 * from one step until another. The page is rendered at the last step, which is what is
 * seen without scripts and by people who prefer reduced motion; the script below starts
 * at the first.
 */
import Button from './Button.astro';
import Spinner from './Spinner.astro';

const LAST = 10;
const at = (from: number, until = LAST + 1) => ({
	'data-from': String(from),
	'data-until': String(until),
	hidden: !(from <= LAST && LAST < until)
});

const message =
	'After signing in, people land on the home page instead of the page they came for. Send them back there.';

const tools = [
	{
		step: 2,
		icon: 'icon-[lucide--file-text]',
		name: 'Read',
		what: 'src/routes/login/+page.server.ts'
	},
	{ step: 3, icon: 'icon-[lucide--pencil]', name: 'Edit', what: 'src/lib/server/auth.ts' },
	{
		step: 4,
		icon: 'icon-[lucide--pencil]',
		name: 'Edit',
		what: 'src/routes/login/+page.server.ts'
	},
	{ step: 5, icon: 'icon-[lucide--file-plus]', name: 'Write', what: 'src/lib/server/auth.spec.ts' },
	{ step: 6, icon: 'icon-[lucide--terminal]', name: 'Bash', what: 'pnpm test auth' }
];

const files = [
	{ step: 3, status: 'M', dir: 'src/lib/server', name: 'auth.ts', added: 9, removed: 2 },
	{ step: 4, status: 'M', dir: 'src/routes/login', name: '+page.server.ts', added: 3, removed: 1 },
	{ step: 5, status: 'A', dir: 'src/lib/server', name: 'auth.spec.ts', added: 24, removed: 0 }
];

const diff = [
	[' ', 'export const actions = {'],
	[' ', '  default: async ({ request, url }) => {'],
	[' ', '    await signIn(request);'],
	['-', "    redirect(303, '/');"],
	['+', "    const to = url.searchParams.get('returnTo');"],
	['+', "    redirect(303, safePath(to) ?? '/');"],
	[' ', '  }'],
	[' ', '};']
];

/** The other workspaces in the sidebar, and how each stands. */
const others = [
	{
		title: 'Dark mode for emails',
		icon: 'icon-[lucide--circle-check] text-ok',
		means: 'Ready to merge'
	},
	{
		title: 'Upgrade to Vite 8',
		icon: 'icon-[lucide--circle-x] text-danger',
		means: 'Checks failing'
	},
	{ title: 'Rate-limit invitations', icon: 'icon-[lucide--git-merge] text-merged', means: 'Merged' }
];

const pill =
	'inline-flex h-9 shrink-0 items-center gap-2 rounded-full pl-3 text-sm font-medium whitespace-nowrap';
---

<figure
	class="overflow-hidden rounded-card bg-frame shadow-float ring-1 ring-line/60"
	data-demo
	aria-label="A Geordi workspace, playing through a piece of work"
>
	<!-- the window's title bar: what the workspace is, and the ribbon that says what is next -->
	<div class="flex h-14 items-center gap-3 pr-3 pl-5">
		<span class="flex gap-2" aria-hidden="true">
			<span class="size-3 rounded-full bg-muted/25"></span>
			<span class="size-3 rounded-full bg-muted/25"></span>
			<span class="size-3 rounded-full bg-muted/25"></span>
		</span>
		<span class="ml-2 hidden icon-[lucide--panel-left] size-4 shrink-0 text-muted sm:block"></span>
		<p class="min-w-0 truncate heading text-muted" {...at(0, 1)}>
			New workspace
		</p>
		<p class="min-w-0 truncate heading" {...at(1)}>
			Return people after sign-in
		</p>
		<span class="hidden min-w-0 truncate code-dense text-muted xl:block" {...at(1)}>
			geordi/return-after-sign-in
		</span>

		<div class="ml-auto flex items-center gap-2">
			<span class:list={[pill, 'bg-sunken pr-3 text-muted']} {...at(8)}>
				<span class="icon-[lucide--git-pull-request] size-4"></span>
				<span class="tabular-nums">#412</span>
			</span>
			<span class:list={[pill, 'bg-sunken pr-1 text-muted']} {...at(7, 8)}>
				<span class="hidden sm:inline">3 files changed</span>
				<Button variant="primary" size="sm" icon="icon-[lucide--git-pull-request-arrow]" data-next>
					Create PR
				</Button>
			</span>
			<span class:list={[pill, 'bar-running bg-sunken pr-3 text-muted']} {...at(8, 9)}>
				<span class="icon-[lucide--loader-circle] size-4 motion-safe:animate-checks-spin"></span>
				Checks running
			</span>
			<span class:list={[pill, 'bg-ok/12 pr-1 text-ok']} {...at(9, 10)}>
				<span class="icon-[lucide--circle-check] size-4"></span>
				<span class="hidden sm:inline">Ready to merge</span>
				<Button variant="primary" tone="ok" size="sm" icon="icon-[lucide--git-merge]" data-next>
					Merge PR
				</Button>
			</span>
			<span class:list={[pill, 'bg-merged/15 pr-1 text-merged']} {...at(10)}>
				<span class="icon-[lucide--git-merge] size-4"></span>
				Merged
				<Button variant="primary" tone="merged" size="sm" icon="icon-[lucide--archive]" data-next>
					Archive
				</Button>
			</span>
		</div>
	</div>

	<div class="flex h-120 gap-2 px-2 pb-2 sm:h-136">
		<!-- the sidebar: every workspace, and how its work stands -->
		<aside class="hidden w-64 shrink-0 flex-col sheet-quiet lg:flex">
			<div class="flex-1 space-y-5 p-2">
				<p class="item gap-2.5 px-2.5 py-1.5 text-base">
					<span class="icon-[lucide--layout-grid] size-4 shrink-0"></span>
					Overview
				</p>
				<div>
					<p class="flex h-7 items-center gap-2 px-1.5 text-sm font-semibold text-muted">
						<span class="grid size-5 place-items-center rounded-control bg-codex/20 text-xs text-codex">
							c
						</span>
						chatto
					</p>
					<ul class="space-y-px">
						<li class="item item-active h-8 px-1.5 font-medium" {...at(1)}>
							<span class="grid size-5 shrink-0 place-items-center text-muted/80">
								<span class="icon-[lucide--git-branch] size-4"></span>
							</span>
							<span class="min-w-0 flex-1 truncate">Return people after sign-in</span>
							<span class="grid size-6 shrink-0 place-items-center">
								<span {...at(1, 7)}>
									<Spinner />
								</span>
								<span class="dot dot-live" title="Changes to look at" {...at(7, 8)}></span>
								<span
									class="icon-[lucide--loader-circle] size-4 text-muted motion-safe:animate-checks-spin"
									title="Checks running"
									{...at(8, 9)}
								></span>
								<span
									class="icon-[lucide--circle-check] size-4 text-ok"
									title="Ready to merge"
									{...at(9, 10)}
								></span>
								<span
									class="icon-[lucide--git-merge] size-4 text-merged"
									title="Merged"
									{...at(10)}
								></span>
							</span>
						</li>
						<li class="item h-8 px-1.5">
							<span class="grid size-5 shrink-0 place-items-center text-muted/80">
								<span class="icon-[lucide--git-branch] size-4" {...at(0, 6)}></span>
								<span
									class="icon-[lucide--message-circle-question] size-4 text-accent-ink"
									title="Waiting for your answer"
									{...at(6)}
								></span>
							</span>
							<span class="min-w-0 flex-1 truncate" {...at(0, 6)}>
								Paginate the audit log
							</span>
							<span class="min-w-0 flex-1 truncate font-semibold text-ink" {...at(6)}>
								Paginate the audit log
							</span>
							<span class="grid size-6 shrink-0 place-items-center" {...at(0, 6)}>
								<Spinner />
							</span>
						</li>
						{others.map((other) => (
							<li class="item h-8 px-1.5">
								<span class="grid size-5 shrink-0 place-items-center text-muted/80">
									<span class="icon-[lucide--git-branch] size-4" />
								</span>
								<span class="min-w-0 flex-1 truncate">{other.title}</span>
								<span class="grid size-6 shrink-0 place-items-center">
									<span class:list={['size-4', other.icon]} title={other.means} />
								</span>
							</li>
						))}
					</ul>
				</div>
			</div>
			<p class="item m-2 gap-2.5 px-2.5 py-1.5 text-base">
				<span class="icon-[lucide--settings] size-4 shrink-0"></span>
				Settings
			</p>
		</aside>

		<!-- the conversation -->
		<section class="flex min-w-0 flex-1 flex-col sheet">
			<div class="pane-bar gap-1 px-2">
				<p class="item h-7 px-2 tab-active">
					<span class="icon-[lucide--sparkles] size-3.5 text-claude"></span>
					Claude
				</p>
			</div>
			<div class="flex min-h-0 flex-1 flex-col justify-end gap-4 overflow-hidden px-5 pb-4">
				<p class="m-auto max-w-xs text-center text-sm text-balance text-muted" {...at(0, 1)}>
					Say what you want done.
				</p>
				<p class="ml-auto message bg-bubble" {...at(1)}>
					{message}
				</p>
				<div class="flex gap-3.5" {...at(1)}>
					<span class="grid size-8 shrink-0 place-items-center rounded-control bg-claude/15 text-claude">
						<span class="icon-[lucide--sparkles] size-4.5"></span>
					</span>
					<div class="min-w-0 flex-1 pt-0.5">
						{tools.map((tool) => (
							<p class="flex h-7 items-center gap-2 text-sm text-muted" {...at(tool.step)}>
								<span class:list={['size-3.5 shrink-0', tool.icon]} />
								<span class="shrink-0 font-medium">{tool.name}</span>
								<span class="min-w-0 truncate code-dense">{tool.what}</span>
							</p>
						))}
						<p class="flex h-7 items-center gap-2 text-xs text-muted" {...at(1, 7)}>
							<Spinner /> Working
						</p>
						<p class="mt-2 max-w-prose" {...at(7)}>
							People now return to the page they asked for. The sign-in form carries it as{' '}
							<code class="code text-(--inline-code)">returnTo</code>, and only paths on this site
							are accepted. Tests pass.
						</p>
						<p class="mt-3 flex items-center gap-2 text-sm text-muted" {...at(8)}>
							<span class="icon-[lucide--git-pull-request] size-3.5"></span>
							Opened pull request #412
						</p>
					</div>
				</div>
			</div>
			<!-- the reply box: a light goes round its edge while the agent works -->
			<div class="edge-live m-3 mt-0 card-float pt-2" data-composer>
				<p class="min-h-13 px-4 py-1" data-typed aria-hidden="true" hidden></p>
				<p class="min-h-13 px-4 py-1 text-muted/70" data-placeholder>
					Reply to Claude
				</p>
				<div class="flex items-center gap-1 px-3 pb-3 text-sm text-muted">
					<span class="flex h-7 items-center gap-1.5 px-1.5">
						<span class="icon-[lucide--sparkles] size-3.5 text-claude"></span>
						Claude
					</span>
					<span class="hidden h-7 items-center gap-1.5 px-1.5 sm:flex">
						<span class="icon-[lucide--shield] size-3.5"></span>
						Auto Mode
					</span>
					<span class="ml-auto grid size-8 place-items-center rounded-full bg-accent text-on-accent">
						<span class="icon-[lucide--arrow-up] size-4"></span>
					</span>
				</div>
			</div>
		</section>

		<!-- beside it: what has changed, and one of the diffs -->
		<div class="hidden w-80 shrink-0 flex-col gap-2 md:flex xl:w-96">
			<section class="flex min-h-0 flex-2 flex-col sheet-quiet">
				<div class="pane-bar px-2">
					<p class="item h-7 px-2 tab-active">Changes</p>
				</div>
				<p class="px-3.5 py-2 text-sm text-muted" {...at(0, 3)}>
					No changes yet.
				</p>
				<ul>
					{files.map((file) => (
						<li
							class="flex items-center gap-2.5 px-3.5 py-1 code-dense whitespace-nowrap"
							{...at(file.step)}
						>
							<span
								class:list={[
									'w-2 shrink-0 text-center font-semibold',
									file.status === 'A' ? 'text-ok' : 'text-accent-ink'
								]}
							>
								{file.status}
							</span>
							<span class="flex min-w-0 flex-1">
								<span class="min-w-0 truncate text-muted">{file.dir}</span>
								<span class="shrink-0 text-muted">/</span>
								<span class="shrink-0">{file.name}</span>
							</span>
							<span class="shrink-0">
								<span class="text-ok">+{file.added}</span>
								{file.removed > 0 && <span class="text-danger">−{file.removed}</span>}
							</span>
						</li>
					))}
				</ul>
			</section>
			<section class="flex min-h-0 flex-3 flex-col sheet-quiet">
				<div class="pane-bar px-2">
					<p class="item h-7 px-2 tab-active code-dense" {...at(4)}>
						+page.server.ts
					</p>
					<p class="item h-7 px-2 tab-inactive" {...at(0, 4)}>
						Diff
					</p>
				</div>
				<p class="px-3.5 py-2 text-sm text-muted" {...at(0, 4)}>
					Diffs fill in as the agent writes.
				</p>
				<pre class="overflow-hidden py-1 code-dense" {...at(4)}>{
					diff.map(([sign, line]) => (
						<span
							class:list={[
								'block px-3.5',
								sign === '+' && 'bg-ok/12',
								sign === '-' && 'bg-danger-soft'
							]}
						><span class:list={['inline-block w-4 select-none', sign === '+' ? 'text-ok' : 'text-danger']}>{sign === ' ' ? '' : sign === '-' ? '−' : '+'}</span>{line}</span>
					))
				}</pre>
			</section>
		</div>
	</div>
</figure>

<p class="mt-3 flex items-center gap-3 px-1 text-sm text-muted">
	<span class="mr-auto">
		This isn't a video. It's the page pretending to be Geordi, and the buttons in its top right
		corner do work.
	</span>
	<button
		type="button"
		class="hidden shrink-0 items-center gap-1.5 rounded-control whitespace-nowrap hover:text-ink"
		data-demo-replay
	>
		<span class="icon-[lucide--rotate-ccw] size-3.5 shrink-0"></span>
		Play again
	</button>
</p>

<script is:inline define:vars={{ message, LAST }}>
	// Inline, right after the window: it is at its first step before it is first painted.
	(() => {
		const demo = document.querySelector('[data-demo]');
		const replay = document.querySelector('[data-demo-replay]');
		if (!demo || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const parts = [...demo.querySelectorAll('[data-from]')];
		const composer = demo.querySelector('[data-composer]');
		const typed = demo.querySelector('[data-typed]');
		const placeholder = demo.querySelector('[data-placeholder]');

		/** How long each step is looked at before the next (ms). The first is spent typing. */
		const HOLD = [400, 1000, 900, 1200, 1300, 1000, 1700, 3600, 3200, 3600, 9000];
		let step = 0;
		let timer;
		let visible = true;

		function show(now) {
			step = now;
			for (const part of parts) {
				part.hidden = !(Number(part.dataset.from) <= now && now < Number(part.dataset.until));
			}
			// the agent works from the message until its reply
			composer.toggleAttribute('data-live', now >= 1 && now < 7);
			typed.hidden = now > 0;
			placeholder.hidden = now === 0;
		}

		function type(index) {
			typed.textContent = message.slice(0, index);
			if (index < message.length) timer = setTimeout(type, 24, index + 1);
			else {
				typed.removeAttribute('data-typing');
				timer = setTimeout(go, HOLD[0], 1);
			}
		}

		function go(now) {
			clearTimeout(timer);
			if (now > LAST) now = 0;
			show(now);
			if (!visible) return;
			if (now === 0) {
				typed.setAttribute('data-typing', '');
				timer = setTimeout(type, 700, 0);
			} else timer = setTimeout(go, HOLD[now], now + 1);
		}

		// the ribbon's buttons do what they say: each takes the work a step further
		demo.addEventListener('click', (event) => {
			if (event.target.closest('[data-next]')) go(step + 1);
		});
		replay.classList.replace('hidden', 'inline-flex');
		replay.addEventListener('click', () => go(0));

		// it only plays while it is looked at
		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			if (visible) go(step);
			else clearTimeout(timer);
		}).observe(demo);

		show(0);
		typed.textContent = '';
		demo.setAttribute('data-playing', '');
	})();
</script>
