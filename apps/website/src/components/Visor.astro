---
/** Geordi's mark: a visor, the band with its slats, in the colour of the text around it. */
type Props = { class?: string };
const { class: extra = 'h-3.5 w-7' } = Astro.props;
---

<svg viewBox="0 0 28 14" class:list={['shrink-0', extra]} fill="none" aria-hidden="true">
	<g stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
		<rect x="1" y="1" width="26" height="12" rx="6"></rect>
		<path d="M8.5 5v4M14 5v4M19.5 5v4"></path>
	</g>
</svg>
