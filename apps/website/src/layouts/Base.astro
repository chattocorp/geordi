---
import '../styles/site.css';
import Button from '../components/Button.astro';
import Visor from '../components/Visor.astro';
import { site } from '../site.ts';

type Props = { title?: string; description?: string };
const {
	title = `${site.title}: a desktop app for running coding agents`,
	description = site.description
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="color-scheme" content="light dark" />
		<!-- Light or dark as the system is, decided before first paint (as the app does). -->
		<script is:inline>
			(() => {
				const dark = matchMedia('(prefers-color-scheme: dark)');
				const apply = () => document.documentElement.classList.toggle('dark', dark.matches);
				apply();
				dark.addEventListener('change', apply);
			})();
		</script>
	</head>
	<body class="min-h-dvh">
		<a
			href="#main"
			class="sr-only rounded-full bg-accent px-4 py-2 font-semibold text-on-accent focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-20"
		>
			Skip to content
		</a>
		<!-- The bar at the top, as every page of the app has one: on the frame, above the sheets. -->
		<header class="sticky top-0 z-10 bg-frame/90 backdrop-blur-sm">
			<div class="column flex h-14 items-center gap-1">
				<a
					href="/"
					class="mr-auto flex items-center gap-2.5 rounded-control px-3 py-1.5 font-semibold"
				>
					<Visor />
					Geordi
				</a>
				<Button variant="ghost" href="#features" class="px-3 max-sm:hidden">
					Features
				</Button>
				<Button variant="ghost" href="#install" class="px-3 max-sm:hidden">
					Install
				</Button>
				<Button variant="ghost" href={site.repo} class="px-3">
					GitHub
				</Button>
				<Button variant="primary" href={site.download} icon="icon-[lucide--download]" class="ml-2">
					Download
				</Button>
			</div>
		</header>
		<main id="main" class="column space-y-2 pb-2">
			<slot />
		</main>
		<footer class="column flex flex-wrap items-center gap-x-6 gap-y-2 px-5 py-8 text-sm text-muted">
			<span class="mr-auto flex items-center gap-2.5">
				<Visor />
				Geordi {site.version}, made by
				<a
					href="https://github.com/chattocorp"
					class="text-ink underline decoration-accent underline-offset-2"
				>
					ChattoCorp
				</a>
			</span>
			<a href={site.repo} class="hover:text-ink">
				GitHub
			</a>
			<a href={`${site.repo}/releases`} class="hover:text-ink">
				Releases
			</a>
			<a href={site.docs.selfHosting} class="hover:text-ink">
				Self-hosting
			</a>
			<a href={site.docs.configuration} class="hover:text-ink">
				Configuration
			</a>
		</footer>
	</body>
</html>
