{
	"name": "@geordi/web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "GEORDI_DATA_DIR=../../.data vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"start": "HOST=${HOST:-127.0.0.1} node build"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.154",
		"@iconify/tailwind4": "^1.2.3",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "catalog:",
		"@types/ws": "^8.18.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "catalog:",
		"vite": "^8.3.0",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@geordi/protocol": "workspace:*",
		"@valibot/to-json-schema": "^1.8.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"markdown-it": "^15.0.3",
		"shiki": "^4.6.0",
		"valibot": "^1.5.0",
		"ws": "^8.23.0"
	}
}
