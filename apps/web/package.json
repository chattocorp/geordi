		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "catalog:",
		"@types/ws": "^8.18.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "catalog:",
		"vite": "^8.3.0",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@geordi/protocol": "workspace:*",
