{
	"name": "geordi",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --parallel --filter './apps/*' dev",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm -r test",
		"desktop": "pnpm --filter @geordi/desktop start",
		"desktop:dev": "pnpm --filter @geordi/desktop dev:app",
		"desktop:package": "pnpm --filter @geordi/desktop package",
		"desktop:dmg": "pnpm --filter @geordi/desktop dmg",
		"desktop:install": "pnpm --filter @geordi/desktop app:install"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "catalog:",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.7",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"typescript": "catalog:",
		"typescript-eslint": "^8.60.1"
	}
}
