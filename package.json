{
	"name": "geordi",
	"private": true,
	"license": "Apache-2.0",
	"author": "ChattoCorp GmbH",
	"type": "module",
	"scripts": {
		"dev": "pnpm --parallel --filter './apps/*' dev",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm -r test",
		"cli": "pnpm --filter @geordi/cli start",
		"desktop": "pnpm --filter @geordi/desktop start",
		"desktop:dev": "pnpm --filter @geordi/desktop dev:app",
		"desktop:jj": "node scripts/prototypes/jj-desktop.mjs",
		"desktop:package": "pnpm --filter @geordi/desktop package",
		"desktop:dmg": "pnpm --filter @geordi/desktop dmg",
		"desktop:install": "pnpm --filter @geordi/desktop app:install"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "catalog:",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-astro": "^1.1.2",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.0",
		"typescript": "catalog:",
		"typescript-eslint": "^8.73.0"
	}
}
